{
	auto_https off
}

:80 {
	encode gzip

	# Agent ingest API
	handle /v1/* {
		reverse_proxy ingest:3002
	}

	# Control plane API
	@api path /auth/* /orgs/* /internal/* /billing/* /invites/* /integrations/* /status/* /health
	handle @api {
		reverse_proxy api:3001
	}

	# Next.js dashboard + marketing
	handle {
		reverse_proxy web:3000
	}
}
