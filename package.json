{
  "name": "vigilai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted VPS monitoring SaaS",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @vigilai/db generate",
    "db:migrate": "pnpm --filter @vigilai/db migrate",
    "db:studio": "pnpm --filter @vigilai/db studio",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "agent:dev": "pnpm --filter @vigilai/agent dev",
    "smoke": "pnpm --filter @vigilai/db exec tsx ../../tests/e2e/smoke.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
